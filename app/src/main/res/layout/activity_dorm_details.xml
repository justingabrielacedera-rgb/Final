<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Room Image -->
        <ImageView
            android:id="@+id/imgRoom"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:background="#FFFFFF"
            android:layout_marginBottom="16dp" />

        <!-- Room Name -->
        <TextView
            android:id="@+id/txtRoomName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dorm Name"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="12dp"
            android:background="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <!-- Location -->
        <TextView
            android:id="@+id/txtLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Location"
            android:textSize="14sp"
            android:textColor="#666666"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Room Type -->
        <TextView
            android:id="@+id/txtType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Room Type"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="10dp"
            android:background="#E3F2FD"
            android:layout_marginBottom="8dp" />

        <!-- Price -->
        <TextView
            android:id="@+id/txtPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="₱0 / month"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/holo_green_dark"
            android:padding="10dp"
            android:layout_marginBottom="8dp" />

        <!-- Availability -->
        <TextView
            android:id="@+id/txtAvailability"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Available"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="8dp"
            android:background="#E8F5E9"
            android:layout_marginBottom="12dp" />

        <!-- Details -->
        <TextView
            android:id="@+id/txtDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Room details here..."
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Check In -->
        <EditText
            android:id="@+id/etCheckIn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Select Check-in Date"
            android:focusable="false"
            android:clickable="true"
            android:inputType="none"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:layout_marginBottom="12dp" />

        <!-- Check Out -->
        <EditText
            android:id="@+id/etCheckOut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Select Check-out Date"
            android:focusable="false"
            android:clickable="true"
            android:inputType="none"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:layout_marginBottom="16dp" />

        <!-- Stay Type -->
        <RadioGroup
            android:id="@+id/radioStayType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rbTransient"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transient"
                android:layout_marginEnd="30dp" />

            <RadioButton
                android:id="@+id/rbBedspace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bedspace" />
        </RadioGroup>

        <!-- Advance Payment -->
        <CheckBox
            android:id="@+id/cbAdvancePay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="I agree to pay advance payment"
            android:visibility="gone"
            android:layout_marginBottom="20dp" />

        <!-- Book Button -->
        <Button
            android:id="@+id/btnBookNow"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Book Now"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:backgroundTint="#FFE18A" />

    </LinearLayout>
</ScrollView>